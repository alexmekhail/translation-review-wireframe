# Copy to .env. Local PostgreSQL (or `docker compose up -d db` from the repo root).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/translation_review
# Disposable database for tests: its schema is dropped and recreated.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/translation_review_test
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
