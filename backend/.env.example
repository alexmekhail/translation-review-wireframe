# Copy to .env (git-ignored) and replace CHANGE_ME with your local Postgres password.
# With Docker: use the POSTGRES_PASSWORD you set for `docker compose up -d db` (repo root).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/translation_review
# Disposable database for tests: its schema is dropped and recreated.
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/translation_review_test
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
